<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.1.0-preview.1</Version>
    <Company>RadioTEDU Technologies</Company>
    <Authors>RadioTEDU Technologies / RTAI</Authors>
    <Product>RadioTEDU OnAir Next</Product>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ArtifactsPath Condition="'$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)/RadioTEDU/OnAirNext-Dev/build</ArtifactsPath>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$(MSBuildThisFileDirectory)artifacts/build</ArtifactsPath>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <Deterministic>true</Deterministic>
    <SourceRevisionId Condition="'$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</SourceRevisionId>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_SHA)' != ''">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
